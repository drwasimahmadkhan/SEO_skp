# Use Postgres via docker-compose, or SQLite for local-only:
# DATABASE_URL=postgresql+psycopg2://audit:audit@localhost:5432/seo_audit
DATABASE_URL=sqlite:///./seo_audit.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PAGE_LIMIT=25
REQUEST_DELAY_MS=300
REQUEST_TIMEOUT_SEC=15
CRAWLER_USER_AGENT=SEO-AEO-GEO-Auditor/1.0 (+local-audit)
